# ==========================================
# 1. Cloudinary Credentials
# (Found in Cloudinary Dashboard -> Settings / API Keys)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=desi dreams sober

# ==========================================
# 2. Supabase Credentials
# (Found in Supabase Project Settings -> API)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==========================================
# 3. Blotato API Credentials
# ==========================================
BLOTATO_API_KEY=your_blotato_api_key
BLOTATO_ACCOUNT_ID=your_instagram_account_id_in_blotato

# ==========================================
# 4. Automation Settings
# ==========================================
WEBSITE_URL=https://desidreams.fun
CTA_COMMENT_TRIGGER=ACCESS
